<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TbtMemoryCleaner.Ui</RootNamespace>
    <AssemblyName>TbtMemoryCleaner.Ui</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TbtInstallDir Condition="'$(TbtInstallDir)' == ''">C:\Program Files\ThinkBook Toolkit</TbtInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TbtMemoryCleaner.Core\TbtMemoryCleaner.Core.csproj" />
    <Reference Include="ThinkBookToolkit.PluginApi">
      <HintPath>$(TbtInstallDir)\ThinkBookToolkit.PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ThinkBookToolkit.PluginUi">
      <HintPath>$(TbtInstallDir)\ThinkBookToolkit.PluginUi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
