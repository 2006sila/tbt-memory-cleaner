<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Tests</AssemblyName>
    <RootNamespace>Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416</NoWarn>
    <TbtInstallDir Condition="'$(TbtInstallDir)' == ''">C:\Program Files\ThinkBook Toolkit</TbtInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TbtMemoryCleaner.Core\TbtMemoryCleaner.Core.csproj" />
    <ProjectReference Include="..\..\src\TbtMemoryCleaner\TbtMemoryCleaner.csproj" />
    <Reference Include="ThinkBookToolkit.PluginApi">
      <HintPath>$(TbtInstallDir)\ThinkBookToolkit.PluginApi.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
