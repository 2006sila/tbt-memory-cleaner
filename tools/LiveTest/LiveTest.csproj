<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>LiveTest</AssemblyName>
    <RootNamespace>LiveTest</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416</NoWarn>
    <TbtInstallDir Condition="'$(TbtInstallDir)' == ''">C:\Program Files\ThinkBook Toolkit</TbtInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TbtMemoryCleaner.Core\TbtMemoryCleaner.Core.csproj" />
  </ItemGroup>

</Project>
