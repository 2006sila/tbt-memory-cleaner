<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ManifestCheck</AssemblyName>
    <RootNamespace>ManifestCheck</RootNamespace>
    <NoWarn>CA1416</NoWarn>
    <TbtInstallDir Condition="'$(TbtInstallDir)' == ''">C:\Program Files\ThinkBook Toolkit</TbtInstallDir>
  </PropertyGroup>

</Project>
